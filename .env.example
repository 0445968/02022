# ─────────────────────────────────────────────────────────────
# Simply Raizal — environment variables
# Copy this file to .env and fill in the required values.
# Required values are already provisioned in this Bolt project's .env.
# ─────────────────────────────────────────────────────────────

# --- Required (provisioned automatically) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Future services (NOT required for Stage 1) ---

# Media / image storage (Stage 2+)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Weather widget data (Stage 2+)
WEATHER_API_KEY=

# Payments / subscriptions (Stage 2+)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Raizal Radio stream (Stage 2+)
RADIO_STREAM_URL=
