# ─────────────────────────────────────────────────────────────
# Simply Raizal — environment variables
# Copy this file to .env and fill in the required values.
# Required values are already provisioned in this Bolt project's .env.
# ─────────────────────────────────────────────────────────────

# --- Required (provisioned automatically) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Future services (NOT required for Stage 1) ---

# Media / image storage (Stage 2+)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Weather widget data (Stage 2+)
WEATHER_API_KEY=

# Payments / subscriptions (Stage 2+)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Raizal Radio stream (Stage 2+)
RADIO_STREAM_URL=

# --- CT-02 rollout (leave false until reviewed migrations AND full API/RLS cutover) ---
CT_STAFF_ACCESS_V2_ENABLED=false
# --- CT-02i: private draft bucket / upload / preview; OFF until coordinated cutover ---
CT_MEDIA_PRIVATE_DRAFTS_ENABLED=false

# --- CT-02c mutations: separate gate, server-only secret, OFF by default ---
CT_STAFF_ADMIN_MUTATIONS_ENABLED=false
# SUPABASE_SERVICE_ROLE_KEY=  # SERVER ONLY; configure only after explicit approval

# CT-03b individual overrides are separately disabled until approved schema + owner bootstrapping
CT_STAFF_OVERRIDE_MUTATIONS_ENABLED=false

# CT-03c audited role preset edits; activate only after approved grants + full cutover
CT_STAFF_PRESET_MUTATIONS_ENABLED=false

# CT-04a.3 invitation API and UI; only after reviewed schema/Owner and full cutover
CT_STAFF_INVITATIONS_ENABLED=false

# CT-04b first-login private profile; review migration and gates before enabling
CT_STAFF_ONBOARDING_ENABLED=false

# CT-04b.2 private byline review only; no public attribution changes
CT_STAFF_BYLINE_REVIEW_ENABLED=false

# CT-05b.1 requires reviewed assigned-copy trigger and v2 rollout; default off
CT_ASSIGNED_DRAFT_EDITOR_ENABLED=false

# CT-05b.2 requires assigned-draft + reviewed revision guard/RPC migration
CT_ASSIGNED_REVISION_EDITOR_ENABLED=false

# CT-05b.3 requires reviewed atomic writer draft migration and assigned editor
CT_WRITER_DRAFT_CREATION_ENABLED=false

# CT-05b.4 requires reviewed approved-media migration and assigned editor
CT_ASSIGNED_APPROVED_MEDIA_ENABLED=false

# CT-06a requires reviewed assignment lifecycle migration; default off
CT_STORY_ASSIGNMENTS_ENABLED=false

# CT-06b.1 review decision API; UI and publication gate follow; default off
CT_STORY_REVIEW_ENABLED=false

# CT-06b.2b requires review lifecycle + inbox migration; default off
CT_REVIEW_INBOX_ENABLED=false

# CT-06c.1: install only with completed scheduling contract and reviewed rollout
CT_REVIEWED_PUBLICATION_ENABLED=false

# CT-06c.2 reviewed queue; keep off until CT08 job and calendar verified
CT_REVIEWED_SCHEDULING_ENABLED=false

# CT-07a comment moderation RPCs; UI/report decisions follow; default off
CT_COMMENT_MODERATION_ENABLED=false

# CT-07c.1 audited report queue API; UI and reader reporting follow
CT_COMMENT_REPORTS_ENABLED=false

# CT-07c.2b reader reporting requires audited report migrations and staff report flag
CT_READER_REPORTING_ENABLED=false

# CT-07d atomic page-scoped bulk comment actions
CT_COMMENT_BULK_ENABLED=false
